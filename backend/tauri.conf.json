{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accuenergy Metering",
  "version": "0.1.0",
  "identifier": "com.accuenergy.metering",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Accuenergy Metering v0.1.0",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Syed Hassaan Shah",
    "copyright": "Copyright (c) 2026 Syed Hassaan Shah",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
